RENTCAST_API_KEY=replace_with_your_key

# Two-app setup (see docs/two-apps-deployment.md). These are public, build-time values:
# they are baked into the page, so only put web addresses here, never secrets.
#
# Set on the RENTER Vercel project: where the "For property managers" button goes.
# VITE_MANAGER_URL=https://your-manager-project.vercel.app
# Set on the MANAGER Vercel project: where "Back to RentWell" goes.
# VITE_RENTER_URL=https://your-renter-project.vercel.app
