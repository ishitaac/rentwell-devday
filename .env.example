RENTCAST_API_KEY=replace_with_your_key

# Find a Roommate (AI beta). Off by default; set to 1 to show the entry point on the Living preferences screen.
# VITE_ROOMMATE_AI=1

# Roommate AI server (Claude) - server-only. Mounted at api/roommate-ai.ts but denies everyone (401) until authentication is supplied by a deployment.
# ROOMMATE_AI_ENABLED=1
# ANTHROPIC_API_KEY=
# ROOMMATE_AI_MODEL=claude-sonnet-5-5
# ROOMMATE_AI_MAX_TOKENS=1200
# ROOMMATE_AI_TIMEOUT_MS=20000
# ROOMMATE_AI_MAX_INPUT_CHARS=2000
# ROOMMATE_AI_RATE_LIMIT=20

# Fictional AI roommate demo endpoint (api/roommate-demo.ts). Presenter-gated, synthetic persona only, off by default.
# Needs ROOMMATE_AI_ENABLED=1, ANTHROPIC_API_KEY, and all of the following. The access code is a shared secret that the
# presenter types into the chat panel; never put it in a VITE_ variable (those are public).
# ROOMMATE_DEMO_ENABLED=1
# ROOMMATE_DEMO_ACCESS_CODE=            # 12+ characters
# ROOMMATE_DEMO_ALLOWED_ORIGINS=https://your-demo-site.example
# ROOMMATE_DEMO_RATE_LIMIT=30           # chat turns per IP per 10 minutes (per server instance)
# ROOMMATE_DEMO_DAILY_LIMIT=300         # total turns per day (per server instance)
