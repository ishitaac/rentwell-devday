RENTCAST_API_KEY=replace_with_your_key

# Two-app setup (see docs/two-apps-deployment.md). These are public, build-time values:
# they are baked into the page, so only put web addresses here, never secrets.
#
# Set on the RENTER Vercel project: where the "For property managers" button goes.
# VITE_MANAGER_URL=https://your-manager-project.vercel.app
# Set on the MANAGER Vercel project: where "Back to RentWell" goes.
# VITE_RENTER_URL=https://your-renter-project.vercel.app

# Find a Roommate (AI beta). Off by default; set to 1 to show the entry point on the Living preferences screen.
# VITE_ROOMMATE_AI=1

# Roommate AI server (Claude) - server-only. Mounted at api/roommate-ai.ts but denies everyone (401) until authentication is supplied by a deployment.
# ROOMMATE_AI_ENABLED=1
# ANTHROPIC_API_KEY=
# ROOMMATE_AI_MODEL=claude-sonnet-5-5
# ROOMMATE_AI_MAX_TOKENS=1200
# ROOMMATE_AI_TIMEOUT_MS=20000
# ROOMMATE_AI_MAX_INPUT_CHARS=2000
# ROOMMATE_AI_RATE_LIMIT=20

# Fictional AI roommate demo endpoint (api/roommate-demo.ts). Presenter-gated, synthetic persona only, off by default.
# Needs ROOMMATE_AI_ENABLED=1, ANTHROPIC_API_KEY, and all of the following. The access code is a shared secret that the
# presenter types into the chat panel; never put it in a VITE_ variable (those are public).
# ROOMMATE_DEMO_ENABLED=1
# ROOMMATE_DEMO_ACCESS_CODE=            # 12+ characters
# ROOMMATE_DEMO_ALLOWED_ORIGINS=https://your-demo-site.example
# ROOMMATE_DEMO_RATE_LIMIT=30           # chat turns per IP per 10 minutes (per server instance)
# ROOMMATE_DEMO_DAILY_LIMIT=300         # total turns per day (per server instance)

# Fine Print lease reader (server-only, never add a VITE_ prefix). Without a key the sample lease still works from its saved analysis.
# Copy to .env.local (gitignored).
# ANTHROPIC_API_KEY=            # shared with the Roommate AI block above
# FINE_PRINT_MODEL=claude-sonnet-5-5
# FINE_PRINT_ROUTER_MODEL=claude-haiku-5-5

# Supabase listings (see docs/supabase-listings.md)
# Public, read-only; safe in the browser. Set on BOTH Vercel projects (Preview + Production):
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=
# Server/seed only. NEVER a VITE_ variable. Used by `pnpm data:seed` from .env.local:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
