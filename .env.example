RENTCAST_API_KEY=replace_with_your_key

# Find a Roommate (AI beta). Off by default; set to 1 to show the entry point on the Living preferences screen.
# VITE_ROOMMATE_AI=1

# Roommate AI server (Claude) - server-only. Mounted at api/roommate-ai.ts but denies everyone (401) until authentication is supplied by a deployment.
# ROOMMATE_AI_ENABLED=1
# ANTHROPIC_API_KEY=
# ROOMMATE_AI_MODEL=claude-sonnet-5-5
# ROOMMATE_AI_MAX_TOKENS=1200
# ROOMMATE_AI_TIMEOUT_MS=20000
# ROOMMATE_AI_MAX_INPUT_CHARS=2000
# ROOMMATE_AI_RATE_LIMIT=20
