{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:manager": "vite --config vite.manager.config.ts",
    "build:manager": "vite build --config vite.manager.config.ts && node scripts/finalize-manager-build.mjs",
    "preview:manager": "vite preview --config vite.manager.config.ts",
    "format": "oxfmt",
    "test": "vitest run",
    "test:data": "node --test scripts/rentcast-data.test.mjs scripts/demo-listings.test.mjs",
    "data:rentcast": "node --env-file-if-exists=.env.local scripts/fetch-rentcast-listings.mjs",
    "data:demo": "node scripts/build-demo-listings.mjs",
    "typecheck": "tsc --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "eval": "tsx eval/run.ts",
    "cache:sample": "tsx scripts/cache-sample.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm check:bundle",
    "data:seed": "node --env-file-if-exists=.env.local scripts/seed-supabase.mjs",
    "eval:walkthrough": "node --env-file-if-exists=.env.local --import tsx eval/walkthrough.ts",
    "cache:walkthrough": "node --env-file-if-exists=.env.local --import tsx scripts/cache-walkthrough-sample.ts",
    "try:photo": "node --env-file-if-exists=.env.local --import tsx scripts/try-photo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@supabase/supabase-js": "^2.119.2",
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.1.1"
  }
}
